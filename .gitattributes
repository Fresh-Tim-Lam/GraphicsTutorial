# 文本文件统一换行策略
* text=auto

# 特定文本类型
*.md text
*.cpp text
*.hpp text
*.h text
*.cmake text
CMakeLists.txt text
# 批处理脚本必须保持 CRLF：LF 会让 cmd.exe 解析错乱（脚本内用 chcp 65001 输出中文）
*.cmd text eol=crlf
*.bat text eol=crlf
*.gitignore text
*.json text
*.yml text
*.yaml text

# 二进制资源
*.png binary
*.jpg binary
*.ico binary
*.bmp binary
